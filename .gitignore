client/Client/Client/assets/

# ---- Serverfiles v5 (MartySama) ----
source/metin2_server/Srcs/Server/game/OBJDIR/
source/metin2_server/Srcs/Server/db/OBJDIR/
source/metin2_server/Srcs/Server/**/OBJDIR/

# ---- Grafos graphify (generados) ----
**/graphify-out/

# ---- Repos / paquetes ----
node_modules/
*.tgz
*.rar

# ============================================================
# Proyecto Metin2 — carpetas pesadas que NO van al repo
# (binarios, instalaciones, backups, dependencias)
# ============================================================

# ---- Clientes instalados / descargados (SOLO en la raíz del repo) ----
/client/
/client-om2/

# ---- Backups ----
/archive/

# ---- Dependencias externas (se regeneran/descargan) ----
/Extern/

# ---- Herramientas locales de la máquina ----
/.opencode/
/.omo/
/.codegraph/
/.commandcode/
/systems/
/mark/
__pycache__/
*.pyc

# ---- Pack compilado y contenido extraído (se genera con PackMakerLite) ----
**/*.epk
**/*.eix
source/metin2_pack/pack/locale/
source/metin2_pack/pack/special_patch_ex/

# ---- Runtime desplegado del servidor (binarios, logs, instancias) ----
source/metin2_svfiles/
**/syslog
**/stdout
**/stderr

# ---- Python / tooling ----
*.egg-info/
.pytest_cache/


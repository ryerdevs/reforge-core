# ---- Sistema / editor ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- Entornos y credenciales ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Logs, PIDs y temporales ----
*.log
*.pid
*.tmp
*.bak
*.orig

# ---- Artefactos de build C++ / cliente ----
**/OBJDIR/
**/build/
**/Debug/
**/Release/
**/x64/
**/Win32/
**/*.o
**/*.a
**/*.obj
**/*.pdb
**/*.ilk
# (*.exe/.dll/.lib/.pch: only the deploy binaries under source/deploy/win/ are tracked;
#  the rest of the workspace produces them under target/, which is gitignored via **/target/.)
**/*.dll
**/*.lib
**/*.pch
**/compile_commands.json

# ---- Runtime del servidor (deploy: binarios generados, logs y backups son locales) ----
# El deploy self-contained bundle (TOMLs, scripts, README, examples) SÍ se commitea;
# el resto (runtime C++ legacy, logs, backups, binarios) se mantiene local.
source/deploy/**/*.exe
source/deploy/**/logs/
source/deploy/**/backups/
source/deploy/**/*.dump
source/deploy/**/*.bak
# Runtime C++ legacy (frozen, no se compila, no es parte del deploy Rust):
source/deploy/main/
source/deploy/baks/
source/deploy/sql/
source/deploy/.gitattributes
source/deploy/.gitignore
source/deploy/CHANGELOG.txt
source/deploy/README-SUMMARY.txt

# ---- Assets extraídos del cliente (modo dev) ----
source/client/**/assets/

# ---- Serverfiles (MartySama) ----
source/server/
source/server/**/OBJDIR/

# ---- Client source and pack (not tracked) ----
source/client/
source/tools/pack/

# ---- Grafos graphify (generados) ----
**/graphify-out/

# ---- Repos / paquetes ----
node_modules/
*.tgz
*.rar

# ============================================================
# Proyecto Metin2 — carpetas pesadas que NO van al repo
# (binarios, instalaciones, backups, dependencias)
# ============================================================

# ---- Clientes instalados / descargados (SOLO en la raíz del repo) ----
/client/
/client-om2/

# ---- Backups ----
/archive/

# ---- Dependencias externas (se regeneran/descargan) ----
/Extern/

# ---- Herramientas locales de la máquina ----
/.opencode/
/.omo/
/.codegraph/
/.commandcode/
/systems/
/mark/
__pycache__/
*.pyc

# ---- Pack compilado y contenido extraído (se genera con PackMakerLite) ----
**/*.epk
**/*.eix
source/tools/pack/locale/
source/tools/pack/special_patch_ex/

# ---- Tool binaries (se regeneran con cargo / MSBuild) ----
source/tools/proto/*.exe

# ---- Dependencias de build del cliente (externas) ----
source/client/Extern/

# ---- Python / tooling ----
*.egg-info/
.pytest_cache/

# ---- Rust (reforge) ----
**/target/

# pi runtime artifacts
.pi-lens/
.pi-loop-log.jsonl
probe.txt
check_probe.txt

# deepwork state (local only)
.slim/deepwork/

